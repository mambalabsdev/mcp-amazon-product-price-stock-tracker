{
  "name": "@mambalabsdev/mcp-amazon-product-price-stock-tracker",
  "version": "1.0.0",
  "description": "MCP server for Amazon Product, Price, and Stock Tracker. Amazon price, stock, seller, and rating by ASIN or URL on 9 marketplaces, with change rows between runs. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-amazon-product-price-stock-tracker": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amazon",
    "amazon-scraper",
    "price-tracker",
    "asin",
    "ecommerce",
    "stock-monitor",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/amazon-product-price-stock-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-amazon-product-price-stock-tracker"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-amazon-product-price-stock-tracker"
